{
  "apiVersion": 1,
  "id": "changhong.aicraft.hyt",
  "version": "0.6.6",
  "requires": {
    "opencode": "^2.2.5"
  },
  "entry": {
    "server": "server/main",
    "gui": "gui/main"
  },
  "externals": [
    "effect",
    "@opencode/plugin",
    "@opencode/schema"
  ],
  "display": {
    "name": "虹云通助手",
    "description": "读本地虹云通消息、收发消息、积累运维知识库、学习你的说话风格并收集任务；自动回复默认只出草稿。",
    "category": "productivity",
    "tools": [
      "hyt.*"
    ],
    "icon": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"> <defs> <linearGradient id=\"hyt-cartoon-body\" x1=\"4\" y1=\"4\" x2=\"20\" y2=\"20\" gradientUnits=\"userSpaceOnUse\"> <stop stop-color=\"#FF6159\"/> <stop offset=\"1\" stop-color=\"#CE2230\"/> </linearGradient> </defs> <rect x=\"3\" y=\"3\" width=\"18\" height=\"18\" rx=\"5.5\" fill=\"url(#hyt-cartoon-body)\"/> <path d=\"M10.6 17c-.7 1.2-1.8 2.2-3 2.6.6-1.2 1-2 1.1-2.6Z\" fill=\"#fff\"/> <rect x=\"5.8\" y=\"6.3\" width=\"12.4\" height=\"10.8\" rx=\"3.5\" fill=\"#fff\"/> <circle cx=\"8.1\" cy=\"12.9\" r=\".64\" fill=\"#FFB0AB\"/> <circle cx=\"15.9\" cy=\"12.9\" r=\".64\" fill=\"#FFB0AB\"/> <circle cx=\"9.7\" cy=\"11.05\" r=\".95\" fill=\"#CE2230\"/> <circle cx=\"14.3\" cy=\"11.05\" r=\".95\" fill=\"#CE2230\"/> <circle cx=\"9.4\" cy=\"10.75\" r=\".27\" fill=\"#fff\"/> <circle cx=\"14\" cy=\"10.75\" r=\".27\" fill=\"#fff\"/> <path d=\"M10.15 13.1c.62 1.1 3.08 1.1 3.7 0\" stroke=\"#CE2230\" stroke-width=\".88\" stroke-linecap=\"round\"/> </svg>",
    "skills": [
      {
        "id": "hyt-assistant",
        "name": "虹云通助手",
        "description": "用 `hyt.*` 工具读取本地虹云通消息与联系人、检索知识库、查看用户说话风格、登记任务、发送消息。第一次使用前先加载本技能。"
      }
    ]
  },
  "skills": [
    {
      "id": "hyt-assistant",
      "name": "虹云通助手",
      "description": "用 `hyt.*` 工具读取本地虹云通消息与联系人、检索知识库、查看用户说话风格、登记任务、发送消息。第一次使用前先加载本技能。",
      "path": "skills/hyt-assistant/SKILL.md"
    }
  ],
  "configuration": {
    "title": "虹云通助手设置",
    "properties": {
      "chfileRoot": {
        "type": "string",
        "default": "",
        "description": "虹云通数据根目录（含 login.db 与各账号目录）。留空时 macOS/Linux 用 ~/Documents/CHFile，Windows 用 %USERPROFILE%\\Documents\\CHFile。"
      },
      "account": {
        "type": "string",
        "default": "",
        "description": "要读取的账号，例如 csT1002173。留空时按 login.db 的上次登录用户推断。"
      },
      "autoStartBridge": {
        "type": "boolean",
        "default": true,
        "description": "需要收发消息时自动拉起本地 bridge 进程；关闭后只读本地库。"
      },
      "bridgePath": {
        "type": "string",
        "default": "",
        "description": "bridge 可执行文件路径。留空时从虹云通数据目录的 Config/bridge.json 探测已运行的实例。"
      },
      "whitelist": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "default": [],
        "description": "允许 AI 自动发送消息的会话或账号。为空时 hyt.send.text 一律拒绝发送。"
      },
      "autoReplyEnabled": {
        "type": "boolean",
        "default": false,
        "description": "AI 托管开关。关闭时只生成草稿，不自动发送。"
      },
      "knowledgePaths": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "default": [],
        "description": "额外导入的本地知识库目录，扫描其中的 md / txt。"
      },
      "mcpKnowledgeTools": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "default": [],
        "description": "登记为知识来源的 MCP 工具名，例如 server.tool。检索时调用，结果不落库除非达到入库门槛。"
      },
      "analysisBatchSize": {
        "type": "number",
        "default": 50,
        "description": "一次风格学习或任务识别处理的样本条数。"
      },
      "analysisIntervalMinutes": {
        "type": "number",
        "default": 30,
        "description": "后台增量分析间隔（分钟）。"
      }
    }
  }
}
