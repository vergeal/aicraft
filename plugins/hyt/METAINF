{
  "apiVersion": 1,
  "id": "changhong.aicraft.hyt",
  "version": "0.6.14",
  "requires": {
    "opencode": "^2.2.5"
  },
  "entry": {
    "server": "server/main",
    "gui": "gui/main"
  },
  "externals": [
    "effect",
    "@opencode/plugin",
    "@opencode/schema"
  ],
  "display": {
    "name": "虹云通助手",
    "description": "读本地虹云通消息、收发消息、积累运维知识库、学习你的说话风格并收集任务；自动回复默认只出草稿。",
    "category": "productivity",
    "tools": [
      "hyt.*"
    ],
    "icon": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"> <defs> <linearGradient id=\"hyt-cartoon-body\" x1=\"0\" y1=\"0\" x2=\"24\" y2=\"24\" gradientUnits=\"userSpaceOnUse\"> <stop stop-color=\"#FF6159\"/> <stop offset=\"1\" stop-color=\"#CE2230\"/> </linearGradient> </defs> <rect width=\"24\" height=\"24\" rx=\"6\" fill=\"url(#hyt-cartoon-body)\"/> <path d=\"M10.1 18.7c-.93 1.6-2.4 2.93-4 3.47.8-1.6 1.33-2.67 1.47-3.47Z\" fill=\"#fff\"/> <rect x=\"3.8\" y=\"4.4\" width=\"16.4\" height=\"14.4\" rx=\"4.6\" fill=\"#fff\"/> <circle cx=\"6.8\" cy=\"13.2\" r=\".85\" fill=\"#FFB0AB\"/> <circle cx=\"17.2\" cy=\"13.2\" r=\".85\" fill=\"#FFB0AB\"/> <circle cx=\"9\" cy=\"10.7\" r=\"1.25\" fill=\"#CE2230\"/> <circle cx=\"15\" cy=\"10.7\" r=\"1.25\" fill=\"#CE2230\"/> <circle cx=\"8.55\" cy=\"10.3\" r=\".36\" fill=\"#fff\"/> <circle cx=\"14.55\" cy=\"10.3\" r=\".36\" fill=\"#fff\"/> <path d=\"M9.6 13.5c.83 1.47 3.97 1.47 4.8 0\" stroke=\"#CE2230\" stroke-width=\"1.2\" stroke-linecap=\"round\"/> </svg>",
    "skills": [
      {
        "id": "hyt-assistant",
        "name": "虹云通助手",
        "description": "用 `hyt.*` 工具读取本地虹云通消息与联系人、检索知识库、查看用户说话风格、登记任务、发送消息。第一次使用前先加载本技能。"
      }
    ]
  },
  "skills": [
    {
      "id": "hyt-assistant",
      "name": "虹云通助手",
      "description": "用 `hyt.*` 工具读取本地虹云通消息与联系人、检索知识库、查看用户说话风格、登记任务、发送消息。第一次使用前先加载本技能。",
      "path": "skills/hyt-assistant/SKILL.md"
    }
  ],
  "configuration": {
    "title": "虹云通助手设置",
    "properties": {
      "chfileRoot": {
        "type": "string",
        "default": "",
        "description": "虹云通数据根目录（含 login.db 与各账号目录）。留空时 macOS/Linux 用 ~/Documents/CHFile，Windows 用 %USERPROFILE%\\Documents\\CHFile。没装客户端也可以只在这里指定目录。"
      },
      "account": {
        "type": "string",
        "default": "",
        "description": "要读取的账号，例如 csT1002173。留空时按插件保存的登录凭据、再按 login.db 的上次登录用户推断。"
      },
      "autoStartBridge": {
        "type": "boolean",
        "default": true,
        "description": "需要收发消息时自动拉起本地 bridge 进程；关闭后只读本地库。"
      },
      "bridgePath": {
        "type": "string",
        "default": "",
        "description": "bridge 可执行文件路径。留空时从虹云通数据目录的 Config/bridge.json 探测已运行的实例。"
      },
      "whitelist": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "default": [],
        "description": "允许 AI 自动发送消息的会话或账号。为空时 hyt.send.text 一律拒绝发送。"
      },
      "autoReplyEnabled": {
        "type": "boolean",
        "default": false,
        "description": "AI 托管开关。关闭时只生成草稿，不自动发送。"
      },
      "knowledgePaths": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "default": [],
        "description": "额外导入的本地知识库目录，扫描其中的 md / txt。"
      },
      "mcpKnowledgeTools": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "default": [],
        "description": "登记为知识来源的 MCP 工具名，例如 server.tool。检索时调用，结果不落库除非达到入库门槛。"
      },
      "analysisBatchSize": {
        "type": "number",
        "default": 50,
        "description": "一次风格学习或任务识别处理的样本条数。"
      },
      "analysisIntervalMinutes": {
        "type": "number",
        "default": 30,
        "description": "后台增量分析间隔（分钟）。"
      }
    }
  }
}
