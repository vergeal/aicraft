{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@opencode/plugin-hyt",
  "version": "0.6.0",
  "description": "虹云通 AI 运维助手：读本地消息库、收发消息、积累知识库、学习说话风格并收集任务",
  "type": "module",
  "license": "MIT",
  "private": true,
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./server/main.ts"
  },
  "scripts": {
    "build": "bun run script/build.ts",
    "pack": "bun run script/pack.ts",
    "typecheck": "bun check --no-script -p tsconfig.test.json",
    "typecheck:gui": "bun check --no-script -p tsconfig.gui.json",
    "typecheck:tsc": "tsc --noEmit -p tsconfig.test.json",
    "test": "bun test"
  },
  "dependencies": {
    "@opencode/plugin": "workspace:*",
    "@opencode/schema": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-typescript": "7.27.1",
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "@typescript/native": "catalog:",
    "babel-preset-solid": "1.9.16",
    "solid-js": "catalog:",
    "typescript": "catalog:"
  }
}
